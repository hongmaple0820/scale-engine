{
  "name": "@hongmaple0820/scale-engine",
  "version": "0.54.2",
  "description": "Executable AI agent governance with workflow gates, evidence, skill/tool orchestration, and traceable HTML artifacts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongmaple0820/scale-engine.git"
  },
  "bugs": {
    "url": "https://github.com/hongmaple0820/scale-engine/issues"
  },
  "homepage": "https://github.com/hongmaple0820/scale-engine#readme",
  "type": "module",
  "bin": {
    "scale": "dist/api/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/README.md",
    "docs/AGENT_ECOSYSTEM.md",
    "docs/PRODUCT_MODULE_TEMPLATES.md",
    "docs/reference",
    "docs/architecture",
    "docs/migration",
    "docs/guides",
    "docs/start",
    "docs/workflow",
    ".scale/skills",
    "!.scale/skills/**/__pycache__",
    "!.scale/skills/**/*.pyc",
    "examples/demo-projects/agent-governance-demo",
    "scripts/workflow/lib",
    "scripts/workflow/docs-health.mjs",
    "scripts/workflow/docs-health.sh",
    "scripts/workflow/learning-health.mjs",
    "scripts/workflow/run-vitest.mjs",
    "scripts/workflow/setup-smoke.mjs",
    "scripts/workflow/provider-rehearsal.mjs",
    "scripts/dashboard-service.ps1"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/workflow/cleanup-dashboard-legacy.mjs && vite build --config vite.dashboard.config.ts",
    "dev": "bun --watch src/api/cli.ts",
    "test": "node scripts/workflow/run-vitest.mjs --timeout-ms 1800000 --testTimeout=180000",
    "test:serial": "vitest run --reporter dot --pool=forks --poolOptions.forks.maxForks=1 --poolOptions.forks.minForks=1",
    "coverage": "node scripts/workflow/run-vitest.mjs --timeout-ms 300000 tests/workflow/gateCatalog.test.ts tests/workflow/verificationProfile.test.ts --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.include=src/workflow/GateCatalog.ts --coverage.include=src/workflow/VerificationProfile.ts --testTimeout=120000",
    "docs:health": "node scripts/workflow/docs-health.mjs",
    "learning:health": "node scripts/workflow/learning-health.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "smoke:setup": "node scripts/workflow/setup-smoke.mjs",
    "smoke:package": "node scripts/workflow/package-smoke.mjs",
    "smoke:providers": "node scripts/workflow/provider-rehearsal.mjs",
    "smoke:gbrain": "node scripts/workflow/provider-rehearsal.mjs --skip-graphify --require-gbrain",
    "smoke:graphify": "node scripts/workflow/provider-rehearsal.mjs --skip-gbrain --require-graphify",
    "release:sync-gitee": "node scripts/release/sync-gitee-releases.mjs",
    "release:check": "npm run learning:health && npm run docs:health && npm run typecheck && npm run lint && npm test && npm run smoke:setup && npm run smoke:providers -- --write-report --large-project examples/demo-projects/agent-governance-demo && npm run build && npm run smoke:package && npm audit --omit=dev --registry=https://registry.npmjs.org && git diff --check && npm pack --dry-run",
    "mcp": "node dist/api/mcp.js",
    "serve": "node dist/api/http.js",
    "dashboard:daemon": "node dist/api/cli.js dashboard daemon"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@typescript-eslint/typescript-estree": "^8.59.3",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "citty": "^0.1.6",
    "content-type": "1.0.5",
    "echarts": "^6.1.0",
    "execa": "^9.3.0",
    "hono": "^4.5.0",
    "js-yaml": "^4.2.0",
    "naive-ui": "^2.44.1",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "type-is": "2.1.0",
    "vue": "^3.5.38",
    "zod": "^3.23.0"
  },
  "overrides": {
    "content-type": "1.0.5",
    "type-is": "2.1.0",
    "qs": "6.15.2"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
