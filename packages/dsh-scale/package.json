{
  "name": "@hongmaple0820/dsh-scale",
  "version": "0.1.2",
  "description": "SCALE Engine governance plugin for DeepSeek Harness — Shield (tool interception), Cortex (instinct injection), Evidence (runtime trail)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-web-app"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@hongmaple0820/scale-engine": ">=0.55.0"
  },
  "devDependencies": {
    "@hongmaple0820/scale-engine": "file:../.."
  },
  "keywords": [
    "dsh-plugin",
    "scale-engine",
    "governance",
    "shield",
    "cortex",
    "evidence"
  ],
  "license": "MIT",
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
